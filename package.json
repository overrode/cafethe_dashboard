{
  "scripts": {
    "dev:css": "npx @tailwindcss/cli -i ./public/assets/css/tailwind-input.css -o ./public/assets/css/tailwind.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./public/assets/css/tailwind-input.css -o ./public/assets/css/tailwind.css --minify",
    "dev": "esbuild resources/js/app.jsx --bundle --outfile=public/assets/js/app.js --watch",
    "build": "esbuild resources/js/app.jsx --bundle --minify --outfile=public/assets/js/app.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "0.14.54",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
